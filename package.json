{
  "name": "bussines_os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:parity": "node scripts/parity-check.js",
    "audit:wiring": "node scripts/wiring-audit.js",
    "verify:all": "npm run build && node scripts/parity-check.js && node scripts/wiring-audit.js",
    "erpnext:up": "powershell -ExecutionPolicy Bypass -File scripts/erpnext/erpnext-local-up.ps1",
    "erpnext:reset": "powershell -ExecutionPolicy Bypass -File scripts/erpnext/erpnext-local-reset.ps1",
    "erpnext:logs": "powershell -ExecutionPolicy Bypass -File scripts/erpnext/erpnext-local-logs.ps1",
    "erpnext:health": "powershell -ExecutionPolicy Bypass -File scripts/erpnext/erpnext-local-health.ps1",
    "nav:validate": "node scripts/nav/nav-validate.mjs",
    "gate:nav": "npm run build && npm run nav:validate",
    "uat:nav": "npx playwright test scripts/uat/nav-gate-s1.spec.ts",
    "uat:install": "npx playwright install",
    "uat:product": "npx playwright test scripts/uat/product-gate-s2.spec.ts",
    "uat:approval": "npx playwright test scripts/uat/approval-gate-s3.spec.ts",
    "uat:evidence": "npx playwright test scripts/uat/evidence-pack-gate-s3.spec.ts",
    "uat:erpnext": "npx playwright test scripts/uat/erpnext-gate-s4.spec.ts",
    "gate:all": "node scripts/gates/gate-all.mjs",
    "gate:all:fast": "node scripts/gates/gate-all.mjs --fast",
    "gate:prod": "node scripts/gates/prod-gate.mjs",
    "uat:packs": "npx playwright test scripts/uat/packs-gate-s6.spec.ts",
    "uat:packs:prod": "npx playwright test --config=playwright.prod.config.ts scripts/uat/packs-gate-s6.spec.ts",
    "uat:e2e:prod": "npx playwright test --config=playwright.prod.config.ts scripts/uat/e2e-erpnext-gate-s7.spec.ts",
    "uat:prewarm": "node scripts/uat/prewarm.mjs",
    "gate:all:prod": "npm run build && npm run gate:prod && npm run nav:validate && npm run uat:packs:prod && npm run uat:e2e:prod"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.31.3",
    "lucide-react": "^0.563.0",
    "next": "14.2.0",
    "openai": "^6.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}