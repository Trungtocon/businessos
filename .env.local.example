# Business OS — Environment Variables
# Copy to .env.local and fill in real values.

# ─── AI Copilot ───────────────────────────────────────────
NEXT_PUBLIC_AI_COPILOT_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# ─── Context Enrichment ──────────────────────────────────
NEXT_PUBLIC_CONTEXT_ENRICH_ENABLED=true
NEXT_PUBLIC_CONTEXT_ENRICH_MAX_URLS=1

# ─── ERPNext (server-only, never NEXT_PUBLIC) ────────────
# Base URL of your ERPNext instance
ERPNEXT_BASE_URL=http://localhost:8081
# ERPNext site name (for multi-tenant setups)
ERPNEXT_SITE=local.site
# API credentials — generate from ERPNext:
#   1. Login to ERPNext as Administrator
#   2. Go to User → API Access (or /api/method/frappe.core.doctype.user.user.generate_keys)
#   3. Click "Generate Keys" for the desired user
#   4. Copy the API Key and API Secret
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# Optional ERPNext settings
# ERPNEXT_VERIFY_TLS=true
# ERPNEXT_DEFAULT_OWNER=admin@example.com
# ERPNEXT_DEFAULT_ASSIGNEE=admin@example.com

# ─── FluentCRM (server-only) ─────────────────────────────
# FLUENTCRM_API_KEY=your_fluentcrm_key
